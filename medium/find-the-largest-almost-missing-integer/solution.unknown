1class Solution {
2    public boolean validPalindrome(String s) {
3        int l=0;
4        int r=s.length()-1;
5        while(l<r){
6            if(s.charAt(l) != s.charAt(r)){
7                return ispalind(s,l+1,r )|| ispalind(s,l,r-1);
8            }
9            l++;
10            r--;
11        }
12        return true;
13    }
14    public boolean ispalind(String s,int l,int r){
15        while(l<r){
16            if(s.charAt(l) != s.charAt(r)){
17                return false;
18            }
19            l++;
20            r--;
21        }
22        return true;
23    }
24}