1class Solution {
2    public int missingMultiple(int[] nums, int k) {
3        HashSet<Integer> set= new HashSet<Integer>();
4        int n=nums.length;
5        for(int num:nums){
6            set.add(num);
7        }
8        int ele=k;
9        while(set.contains(ele)){
10            ele+=k;
11        }
12return ele;
13    }
14}