1class Solution {
2    public int[][] flipAndInvertImage(int[][] image) {
3        for (int i = 0; i < image.length; i++) {
4            int left = 0;
5            int right = image[i].length - 1;
6            while (left <= right) {
7                int temp=image[i][left];
8                image[i][left]=1-image[i][right];
9                image[i][right]=1-temp;
10                left++;
11                right--;
12
13            }
14        }
15        return image;
16
17    }
18}