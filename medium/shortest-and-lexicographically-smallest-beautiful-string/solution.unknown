1class Solution {
2    public int numRescueBoats(int[] people, int limit) {
3        Map<Integer,Integer>map=new HashMap<>();
4        for(int n:people){
5            map.put(n,map.getOrDefault(n,0)+1);
6        }
7        int c=0;
8        int i=0;
9        int j=people.length-1;
10        Arrays.sort(people);
11        while(i<=j){
12            if(people[i]+people[j]<=limit){
13                c++;
14                j--;
15                i++;
16            }else{
17                j--;
18                c++;
19            }
20        }
21        return c;
22        
23    }
24}