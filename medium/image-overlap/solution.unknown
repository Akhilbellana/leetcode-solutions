1class Solution {
2    public int minimumSwaps(int[] nums) {
3        int zeros=0;
4        for(int i=0;i<nums.length;i++){
5            if(nums[i]==0){
6                zeros++;
7            }
8        }
9        if(zeros==0){
10            return 0;
11    }
12    int count=0;
13        for(int i=nums.length-1;i>=0;i--){
14            if(nums[i]!=0){
15                count++;
16                zeros--;
17            }else{
18                zeros--;
19            }
20            if(zeros==0){
21                 return count ;
22            }
23        }
24        return 0;
25
26    }
27}